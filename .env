# Keycloak Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://keycloak.theddt.local
NEXT_PUBLIC_KEYCLOAK_REALM=theddt
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=wiwebb-web-client

# API
# Production — set to the real backend and leave API_PROXY_TARGET unset.
# NEXT_PUBLIC_API_URL=http://api.theddt.local/api/v1

# Development — use a relative URL so the browser calls the Next.js proxy
# (avoids CORS: Mockoon returns Access-Control-Allow-Origin: * which is
# incompatible with credentials: 'include').  API_PROXY_TARGET tells the
# Next.js rewrite where to forward those requests server-to-server.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4011


# Mock auth — set to true to bypass Keycloak entirely (no Docker needed)
# Set to false or remove to use the real Keycloak service
NEXT_PUBLIC_MOCK_AUTH=true

# ── Expo (React Native) app ───────────────────────────────────────────
# RTK Query base URL. Includes /api/v1 because Mockoon's endpointPrefix is
# 'api/v1'. Use the host LAN IP so the physical device (Redmi 8A on the same
# WiFi) can reach the Mockoon container published on 0.0.0.0:4011.
# Emulator alternative: http://10.0.2.2:4011/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.114:4011/api/v1

# Onboarding dev overrides (both default to false; never enable in production)
# SKIP: bypass the gate entirely — go straight to the app regardless of org status
# FORCE: always redirect to onboarding — useful for testing the flow even with an org
NEXT_PUBLIC_SKIP_ONBOARDING=true
NEXT_PUBLIC_FORCE_ONBOARDING=false

